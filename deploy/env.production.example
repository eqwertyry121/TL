APP_ENV=production
HTTP_ADDR=:8080
APP_TIMEZONE=Europe/Belgrade
APP_CURRENCY=RSD
APP_PUBLIC_BASE_URL=https://api.takolako.site
APP_ALLOWED_ORIGINS=https://takolako.site,https://www.takolako.site

# Generate unique production values on the VPS.
APP_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_CLIENT_BOT_USERNAME=TakoLako_main_bot
TELEGRAM_CLIENT_BOT_TOKEN=

# Until a separate staff bot exists, this may be the same token as the client
# bot, but the production target is a separate closed staff bot.
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_STAFF_BOT_TOKEN=

BOOTSTRAP_OWNER_TELEGRAM_ID=1048084234
LOCAL_ROLE_SWITCHER_ENABLED=false
SESSION_TTL=24h
TELEGRAM_INIT_DATA_MAX_AGE=24h
MAX_ITEM_QUANTITY=99
NOTIFICATION_DRY_RUN=false
NOTIFICATION_POLL_INTERVAL=5s
APP_HOST_PORT=18080
