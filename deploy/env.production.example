APP_ENV=production
APP_BUILD_SHA=unknown
HTTP_ADDR=:8080
APP_TIMEZONE=Europe/Belgrade
APP_CURRENCY=RSD
APP_PUBLIC_BASE_URL=https://api.takolako.site
APP_ALLOWED_ORIGINS=https://takolako.site,https://www.takolako.site

# Generate unique production values on the VPS.
# APP_ENCRYPTION_KEY must be 32-byte base64 or at least 32 characters.
# PII_HASH_KEY must be different from APP_ENCRYPTION_KEY and at least 32 characters or 32-byte base64.
APP_ENCRYPTION_KEY=
PII_HASH_KEY=
POSTGRES_PASSWORD=
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_CLIENT_BOT_USERNAME=TakoLako_main_bot
TELEGRAM_CLIENT_BOT_TOKEN=

# Optional. If empty, staff/Admin Mini Apps verify Telegram initData with
# TELEGRAM_CLIENT_BOT_TOKEN. This is the expected setup while we use one bot
# plus backend staff whitelist by Telegram ID.
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_STAFF_BOT_TOKEN=

BOOTSTRAP_OWNER_TELEGRAM_IDS=1048084234,8241921060,8609105840
BOOTSTRAP_OWNER_TELEGRAM_ID=1048084234
LOCAL_ROLE_SWITCHER_ENABLED=false
POSTGRES_MAX_CONNS=8
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_IDLE_TIME=5m
SESSION_TTL=24h
TELEGRAM_INIT_DATA_MAX_AGE=24h
MAX_ITEM_QUANTITY=99
NOTIFICATION_DRY_RUN=false
NOTIFICATION_POLL_INTERVAL=5s
NOTIFICATION_CONCURRENCY=4
NOTIFICATION_BACKLOG_ALERT_AFTER=60s
SERVER_TIMING_ENABLED=false
PII_RETENTION_DAYS=730
FISCAL_PROCESS_ACCEPTED=false
APP_HOST_PORT=18080
MEDIA_VOLUME_HOST_PATH=/srv/tk-delivery/uploads
BACKUP_DIR=/var/backups/tk-delivery
RETENTION_DAYS=14
BACKUP_RSYNC_DEST=
BACKUP_RCLONE_REMOTE=

# Optional production alerts used by deploy/health-alert.sh.
API_HEALTH_URL=https://api.takolako.site/health
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=1048084234
ALERT_STATE_DIR=/var/lib/tk-delivery-alerts
FAILED_NOTIFICATION_THRESHOLD=1
COMPOSE_FILE=/opt/tk-delivery/deploy/docker-compose.api.yml
PROJECT_DIR=/opt/tk-delivery/deploy
