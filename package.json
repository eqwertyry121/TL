{
  "name": "tk-delivery",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check": "pnpm openapi:check && pnpm docs:links:test && pnpm media:check && pnpm media:rendering:test && pnpm media:backfill:cli:test && pnpm go:test:postgres:cli:test && pnpm perf:external-smoke:cli:test && pnpm perf:production-contract:cli:test && pnpm perf:legacy-public-contract:cli:test && pnpm perf:cors-contract:cli:test && pnpm perf:release-acceptance:cli:test && pnpm perf:deployment-diagnostics:cli:test && pnpm perf:release-lab:cli:test && pnpm env:contract:test && pnpm migrations:contract:test && pnpm api:compatibility:test && pnpm performance:beacon:test && pnpm role-switch:test && pnpm architecture:guard:test && pnpm ui:recovery:test && pnpm operations:contract:test && pnpm polling:test && pnpm storage:test && pnpm auth:test && pnpm bootstrap:fallback:test && pnpm startup:contract:test && pnpm startup:assets:test && pnpm load-smoke:test && pnpm -r check",
    "openapi:check": "node scripts/check-openapi-routes.mjs",
    "docs:links:test": "node --test tests/docs-links.test.mjs",
    "media:check": "node scripts/check-media-references.mjs",
    "media:rendering:test": "node --test tests/media-rendering.test.mjs",
    "media:backfill:cli:test": "node --test tests/media-backfill-cli.test.mjs",
    "go:test:postgres:cli:test": "node --test tests/go-postgres-cli.test.mjs",
    "perf:external-smoke:cli:test": "node --test tests/external-smoke-cli.test.mjs",
    "env:contract:test": "node --test tests/env-contract.test.mjs",
    "migrations:contract:test": "node --test tests/migrations-contract.test.mjs",
    "api:compatibility:test": "node --test tests/api-compatibility.test.mjs",
    "performance:beacon:test": "node --experimental-strip-types --test tests/performance-beacon.test.mjs",
    "role-switch:test": "node --experimental-strip-types --test tests/role-switch.test.mjs",
    "architecture:guard:test": "node --test tests/architecture-guard.test.mjs",
    "ui:recovery:test": "node --test tests/error-boundary-contract.test.mjs",
    "operations:contract:test": "node --test tests/operations-contract.test.mjs",
    "polling:test": "node --experimental-strip-types --test tests/performance/polling.test.mjs",
    "storage:test": "node --experimental-strip-types --test tests/client-storage.test.mjs",
    "auth:test": "node --experimental-strip-types --test tests/auth-retry.test.mjs",
    "bootstrap:fallback:test": "node --test tests/bootstrap-fallback.test.mjs",
    "startup:contract:test": "node --test tests/startup-contract.test.mjs",
    "startup:assets:test": "node --test tests/startup-assets.test.mjs",
    "load-smoke:test": "node --test tests/load-smoke.test.mjs",
    "perf:budgets": "node scripts/check-bundle-budgets.mjs",
    "perf:lab": "node tests/performance/run-lab.mjs",
    "perf:release-lab": "node tests/performance/run-release-lab.mjs",
    "perf:release-lab:cli:test": "node --test tests/release-lab-cli.test.mjs",
    "perf:full": "node tests/performance/run-full.mjs",
    "perf:lab:build": "node tests/performance/build-lab.mjs",
    "perf:production:build": "node tests/performance/build-production.mjs",
    "perf:playwright": "pnpm exec playwright test -c tests/performance/playwright.config.ts",
    "perf:smoke": "node scripts/load-smoke.mjs",
    "perf:external-smoke": "node scripts/external-smoke.mjs",
    "perf:production-contract": "node scripts/production-contract.mjs",
    "perf:production-contract:cli:test": "node --test tests/production-contract-cli.test.mjs",
    "perf:legacy-public-contract": "node scripts/legacy-public-contract.mjs",
    "perf:legacy-public-contract:cli:test": "node --test tests/legacy-public-contract-cli.test.mjs",
    "perf:cors-contract": "node scripts/cors-contract.mjs",
    "perf:cors-contract:cli:test": "node --test tests/cors-contract-cli.test.mjs",
    "perf:release-acceptance": "node scripts/release-acceptance.mjs",
    "perf:release-acceptance:cli:test": "node --test tests/release-acceptance-cli.test.mjs",
    "perf:deployment-diagnostics": "node scripts/deployment-diagnostics.mjs",
    "perf:deployment-diagnostics:cli:test": "node --test tests/deployment-diagnostics-cli.test.mjs",
    "go:test": "node scripts/go-toolchain.mjs test ./...",
    "go:test:postgres": "node scripts/go-postgres-test.mjs",
    "go:vet": "node scripts/go-toolchain.mjs vet ./...",
    "api:dev": "node scripts/go-toolchain.mjs run ./backend/cmd/app",
    "media:backfill:dry-run": "node scripts/media-backfill.mjs true",
    "media:backfill": "node scripts/media-backfill.mjs false",
    "build": "pnpm -r build",
    "client:dev": "pnpm --filter @tk-delivery/client dev",
    "client:build": "pnpm --filter @tk-delivery/client build",
    "kitchen:dev": "pnpm --filter @tk-delivery/kitchen dev",
    "courier:dev": "pnpm --filter @tk-delivery/courier dev",
    "admin:dev": "pnpm --filter @tk-delivery/admin dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
