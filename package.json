{
  "name": "tk-delivery",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "check": "pnpm openapi:check && pnpm -r check",
    "openapi:check": "node scripts/check-openapi-routes.mjs",
    "build": "pnpm -r build",
    "client:dev": "pnpm --filter @tk-delivery/client dev",
    "client:build": "pnpm --filter @tk-delivery/client build",
    "kitchen:dev": "pnpm --filter @tk-delivery/kitchen dev",
    "courier:dev": "pnpm --filter @tk-delivery/courier dev",
    "admin:dev": "pnpm --filter @tk-delivery/admin dev"
  }
}
