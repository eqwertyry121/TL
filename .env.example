APP_ENV=development
APP_BUILD_SHA=dev
HTTP_ADDR=:8080
APP_TIMEZONE=Europe/Belgrade
APP_CURRENCY=RSD
APP_PUBLIC_BASE_URL=http://127.0.0.1:18080
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,https://takolako.site,https://www.takolako.site
APP_ENCRYPTION_KEY=change-me-local-dev-key
PII_HASH_KEY=change-me-local-dev-pii-hash-key
MEDIA_DIR=backend/uploads

# Public merchant details rendered in the client legal pages. These are not
# secrets and must exactly match APR/tax records before production card review.
VITE_LEGAL_BUSINESS_NAME=
VITE_LEGAL_REGISTRATION_NUMBER=
VITE_LEGAL_TAX_ID=
VITE_LEGAL_VAT_STATUS=
VITE_LEGAL_REGISTERED_ADDRESS=
VITE_LEGAL_RESTAURANT_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=

# Tokens must be stored only in local .env files or deployment secrets.
# Never commit real Telegram tokens.
TELEGRAM_CLIENT_BOT_USERNAME=TakoLako_main_bot
TELEGRAM_CLIENT_MINI_APP_URL=https://takolako.site/main/
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-local-webhook-secret

# Local bootstrap/test access. This user is seeded as ADMIN/KITCHEN/COURIER for
# local testing and can still use the client app as a normal Telegram user.
BOOTSTRAP_OWNER_TELEGRAM_IDS=1048084234,8241921060,8609105840,7604602332
BOOTSTRAP_OWNER_TELEGRAM_ID=1048084234
LOCAL_ROLE_SWITCHER_ENABLED=true

POSTGRES_DSN=postgres://tk_delivery:tk_delivery@localhost:15432/tk_delivery?sslmode=disable
POSTGRES_MAX_CONNS=8
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_IDLE_TIME=5m
SESSION_TTL=24h
TELEGRAM_INIT_DATA_MAX_AGE=24h
MAX_ITEM_QUANTITY=10
NOTIFICATION_DRY_RUN=true
NOTIFICATION_POLL_INTERVAL=5s
NOTIFICATION_CONCURRENCY=4
NOTIFICATION_BACKLOG_ALERT_AFTER=60s
SERVER_TIMING_ENABLED=true
PII_RETENTION_DAYS=730
FISCAL_PROCESS_ACCEPTED=false
