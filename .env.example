APP_ENV=development
HTTP_ADDR=:8080
APP_TIMEZONE=Europe/Belgrade
APP_CURRENCY=RSD
APP_PUBLIC_BASE_URL=http://127.0.0.1:18080
APP_ENCRYPTION_KEY=change-me-local-dev-key
MEDIA_DIR=backend/uploads

# Tokens must be stored only in local .env files or deployment secrets.
# Never commit real Telegram tokens.
TELEGRAM_CLIENT_BOT_USERNAME=TakoLako_main_bot
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_STAFF_BOT_TOKEN=

# Local bootstrap/test access. This user is seeded as ADMIN/KITCHEN/COURIER for
# local testing and can still use the client app as a normal Telegram user.
BOOTSTRAP_OWNER_TELEGRAM_ID=1048084234
LOCAL_ROLE_SWITCHER_ENABLED=true

POSTGRES_DSN=postgres://tk_delivery:tk_delivery@localhost:15432/tk_delivery?sslmode=disable
SESSION_TTL=24h
TELEGRAM_INIT_DATA_MAX_AGE=24h
MAX_ITEM_QUANTITY=10
NOTIFICATION_DRY_RUN=true
NOTIFICATION_POLL_INTERVAL=5s
